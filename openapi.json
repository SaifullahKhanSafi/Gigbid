        ],
        "title": "Approval"
      },
      "Body_upload_api_portfolio_upload_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "kind": {
            "type": "string",
            "title": "Kind",
            "default": "case_study"
          },
          "skills": {
            "type": "string",
            "title": "Skills",
            "default": ""
          },
          "industry": {
            "type": "string",
            "title": "Industry",
            "default": "general"
          },
          "outcome": {
